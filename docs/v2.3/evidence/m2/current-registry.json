      "targetKind": "file",
      "steps": 5
    },
    {
      "id": "WebCodeSecurityReview",
      "title": "Web/源码安全审计",
      "description": "对本地代码目录做危险调用、敏感信息、依赖与供应链审计，产出 CWE 映射与修复建议。",
      "targetKind": "directory",
      "steps": 4
    },
    {
      "id": "PCAPInvestigation",
      "title": "PCAP 流量取证分析",
