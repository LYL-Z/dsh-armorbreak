      "targetKind": "file",
      "steps": 7
    },
    {
      "id": "DependencyAudit",
      "title": "依赖与供应链审计",
      "description": "对代码目录的依赖清单做盘点、SBOM 生成与密钥泄漏检查；缺少漏洞库时不伪造 CVE 结论。",
