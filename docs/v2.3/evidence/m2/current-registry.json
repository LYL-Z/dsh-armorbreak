      "steps": 4
    },
    {
      "id": "ForensicFileReview",
      "title": "数字取证文件审查",
      "description": "文件类型、哈希、元数据、时间线、IOC 与规则匹配，形成可复核证据链。",
      "targetKind": "file",
      "steps": 6
    },
