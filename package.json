{
  "name": "dsh-armorbreak",
  "version": "2.4.0-preview.1",
  "type": "module",
  "description": "ArmorBreak (破甲) is an independent, open-source security analysis toolkit with local evidence and reports for CLI, MCP, Workbench, and DeepSeek Harness integration.",
  "icon": "./icon.svg",
  "author": {
    "name": "LYL-Z",
    "url": "https://github.com/LYL-Z"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYL-Z/dsh-armorbreak.git"
  },
  "homepage": "https://github.com/LYL-Z/dsh-armorbreak#readme",
  "bugs": {
    "url": "https://github.com/LYL-Z/dsh-armorbreak/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "cordis",
    "agent-preset",
    "reverse-engineering",
    "security-research",
    "dfir",
    "static-analysis",
    "malware-analysis",
    "ctf"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./tools": "./tools.js",
    "./skills": "./skills.js",
    "./client": "./client.js",
    "./core": "./packages/core/index.js",
    "./engine-node": "./packages/engine-node/index.js",
    "./cli": "./packages/cli/index.js",
    "./mcp": "./packages/mcp-server/index.js",
    "./workbench": "./workbench/server.mjs",
    "./configuration-lab": "./packages/core/src/syntheticConfiguration.js",
    "./backup-recovery-lab": "./packages/core/src/syntheticBackupRecovery.js",
    "./plugin-lifecycle": "./lib/catalog/pluginLifecycle.js",
    "./plugin-trust-store": "./lib/catalog/persistentPluginTrust.js",
    "./plugin-lab": "./packages/core/src/syntheticPlugin.js",
    "./isolated-plugin-store": "./packages/core/src/isolatedPluginStore.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "npm-shrinkwrap.json",
    "index.js",
    "tools.js",
    "skills.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "packages",
    "plugins",
    "workbench",
    "skills",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "LICENSES/MIT.txt",
    "LICENSES/CC-BY-4.0.txt",
    "THIRD_PARTY_NOTICES.txt",
    "REUSE.toml",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "AUTHORS.md",
    "GOVERNANCE.md",
    "SUPPORT.md",
    "TRADEMARK.md",
    "ETHICAL_USE.md",
    "docs/v24/distribution.md",
    "docs/media/workbench-guided-v24.png"
  ],
  "bin": {
    "armorbreak": "./packages/cli/index.js",
    "armorbreak-mcp": "./packages/mcp-server/index.js",
    "armorbreak-workbench": "./workbench/server.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "bench": "node benchmarks/bench.mjs",
    "inventory": "node scripts/file-changes.mjs",
    "clean-temp": "node scripts/clean-temp.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "verify:distribution": "node scripts/v24/verify-npm-distribution.mjs"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
